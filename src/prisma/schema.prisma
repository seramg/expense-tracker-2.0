generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
}

model User {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    name      String
    email     String   @unique
    password  String?
    image     String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    providers String[] @default(["credentials"])
    googleId  String?

    @@map("users")
}
